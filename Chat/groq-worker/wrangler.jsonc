{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simoens-groq",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://quimicavisualufv.github.io",
    "GROQ_MODEL": "openai/gpt-oss-120b"
  },
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "917501", "simple": { "limit": 60, "period": 60 } },
    { "name": "SITE_LIMITER", "namespace_id": "917502", "simple": { "limit": 120, "period": 60 } }
  ]
}
